# ────────────────────────────────────────────────────────────────────
# Copy to .env and fill in real values. .env is gitignored.
# ────────────────────────────────────────────────────────────────────

# Memgraph runs without auth by default — leave user/password empty
# unless you've enabled auth on the server.
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# Optional port overrides for docker-compose
# MEMGRAPH_BOLT_PORT=7687
# MEMGRAPH_HTTP_PORT=7444
# MEMGRAPH_LAB_PORT=3000

# Core API (FastAPI) — kg.server entry point
API_HOST=127.0.0.1
API_PORT=7400

# Indexed projects. Add one PROJECT_<NAME>=<abs/path> per project.
# The path must point at a directory with a tsconfig.json so
# scip-typescript can index it.
PROJECT_ADSW=/absolute/path/to/your/adsw/packages/adsw

# ────────────────────────────────────────────────────────────────────
# Copy to .env and fill in real values. .env is gitignored.
# ────────────────────────────────────────────────────────────────────

# ── Neo4j ─────────────────────────────────────────────────────────────
# Used by docker-compose AND by the Python core (see kg/settings.py).
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-pick-a-strong-password
NEO4J_URI=bolt://localhost:7687

# Optional Neo4j tuning (defaults in docker-compose.yml)
# NEO4J_BROWSER_PORT=7474
# NEO4J_BOLT_PORT=7687
# NEO4J_HEAP_INITIAL=1G
# NEO4J_HEAP_MAX=2G
# NEO4J_PAGECACHE=1G

# ── Service endpoints ─────────────────────────────────────────────────
INDEXER_URL=http://localhost:7401
API_HOST=127.0.0.1
API_PORT=7400

# ── Projects to index ─────────────────────────────────────────────────
# Format: PROJECT_<NAME>=<absolute_path_to_codebase_root>
# The name is lowercased and used as the project id everywhere
# (PROJECT_ADSW → 'adsw'). Add one line per codebase.
PROJECT_ADSW=/absolute/path/to/your/adsw/packages/adsw
# PROJECT_NETWORK=/absolute/path/to/your/network/packages/network
